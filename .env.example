# Database connection string (PostgreSQL)
# For Docker: use "postgres" as host (docker-compose service name)
DATABASE_URL=postgresql://payload:payload@postgres:5432/payload

# For local development without Docker: use localhost
#DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Telegram Bot (for access request notifications)
# Create a bot via @BotFather and get the token
# Add the bot to your group and get the chat ID
# Topic IDs are configured per reservation target in the admin panel
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_tg_chatid_here
# Telegram webhook secret (echoed by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header; any random string)
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Google service account with write access to the reservation spreadsheet.
# Raw JSON or base64-encoded JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet the Apps Script is bound to
GOOGLE_SHEETS_ID=
# Optional: reservations tab name. Defaults to the first (and only) tab, which
# is the one the Apps Script scans via getActiveSheet().
GOOGLE_SHEETS_TAB=
# Keyholder registry: a DIFFERENT spreadsheet from the reservations one.
# Share it with the same service account. Falls back to GOOGLE_SHEETS_ID if unset.
GOOGLE_SHEETS_KEYHOLDERS_ID=
